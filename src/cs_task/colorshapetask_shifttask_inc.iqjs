*******************************************************************************************************************
*******************************************************************************************************************
	VALUES: automatically updated
*******************************************************************************************************************
*******************************************************************************************************************

/color:										stores the color of the current stimulus (green/red)
/shape:										stores the shape of the current stimulus (circle/triangle)
/categorizationTask:						the type of primary task: "Color" vs. "Shape"
/shiftTask:									the type of shift task: "Shift" vs. "Repeat"
/responseKeyMapping:						stores whether the mapping of responsekeys for the current shape and color
											are consistent (e.g. consistent = shape AND color are mapped onto same
											response key)


The following variables are used in the counterbalancing of the pre-determined responsekeys:
/group:											Response Key assignment group
													1 = red and circle on one response key (default: A)
													2 = red and triangle on one respone key (default: A)
													3 = red and circle on one response key (default: L)
													4 = red and triangle on one respone key (default: L)

/responseKeyRed:								responsekey for color "red"
/responseKeyGreen:								responsekey for color "green"
/responseKeyCircle:							responsekey for shape "circle"
/responseKeyTriangle:							responsekey for shape "triangle"

/stimulus:										stores the currently presented stimulus
/selectstim:									stores the itemnumber of the current stimulus
/selectCue:										stores the itemnumber of the current cue 
/selectInstruct:								stores the itemnumber of the current instruction slide
/firstTask:										stores the task of the randomly determined first task : 1 = shape; 2 = color												
/nextTrial:										stores the type of shift trial (1 = shift; 2 = repeat) to be presented next
/soa:											stores the current SOA
/countTrials:									counts the number of mixed trials presented (minus first trial)
/helper:										helper variable
												

<values>
/ color = ""
/ shape = ""
/ categorizationTask = ""
/ shiftTask = ""
/ responseKeyMapping = ""
/ group = 0
/ practice = 0
/ countPracticeBlocks = 0
/ practiceAcc = 0
/ practicePass = 1
/ countTestBlocks = 0
/ responseKeyRed = "A"
/ responseKeyGreen = "L"
/ responseKeyCircle = "A"
/ responseKeyTriangle = "L"

/ stimulus = ""
/ selectstim = 1
/ selectCue = 1
/ selectInstruct = 1
/ firstTask = 0
/ nextTrial = 0
/ soa = 0
/ countTrials = 0
/ helper = 0
/ leftResponseTextColor = ""
/ rightResponseTextColor = ""
/ leftResponseTextShape = ""
/ rightResponseTextShape = ""

/ responseCategory = ""
</values>

*******************************************************************************************************************
*******************************************************************************************************************
	EXPRESSIONS
*******************************************************************************************************************
*******************************************************************************************************************

/leftKeyAssignedColor-
/rightKeyAssignedShape:		helper function to assemble the key reminders that are presented at the bottom of the screen


Summary variables: updated after each block

/percentCorrectShape: 			percent correct of shape responses
/percentCorrectColor: 			percent correct of color responses
/meanRTShape:					mean rt of correct shape responses
/meanRTColor:					mean rt of correct color responses

/percentCorrectShif: 			percent correct of shift responses
/percentCorrectRepeat: 		percent correct of repeat responses
/meanRTShift:					mean rt of correct shift responses 
/meanRTRepeat:					mean rt of correct repeat responses 

/switchCost:					calculates the switch cost as the mean reaction-time difference between (correct) switch and (correct) repeat trials.
									=> positive: longer (average) switch latencies 
									=> negative: shorter (average) switch latencies



<expressions>
/ leftKeyAssignedColor = {
	if (values.group == 1 || values.group == 3){
		return "RED";
	} else if (values.group == 2 || values.group == 4){
		return "GREEN";
	}
}
/ rightKeyAssignedColor = {
	if (values.group == 1 || values.group == 3){
		return "GREEN";
	} else if (values.group == 2 || values.group == 4){
		return "RED";
	}
}
/ leftKeyAssignedShape = {
	if (values.group == 1 || values.group == 2){
		return "CIRCLE";
	} else if (values.group == 3 || values.group == 4){
		return "TRIANGLE";
	}	
}
/ rightKeyAssignedShape = {
	if (values.group == 1 || values.group == 2){
		return "TRIANGLE";
	} else if (values.group == 3 || values.group == 4){
		return "CIRCLE";
	}	
}

/ percentCorrectShape = return list.accShape.mean * 100
/ percentCorrectColor = return list.accColor.mean * 100
/ meanRTShape = return list.rtShape.mean
/ meanRTColor = return list.rtColor.mean

/ percentCorrectShift = return list.accShift.mean * 100
/ percentCorrectRepeat = return list.accRepeat.mean * 100
/ meanRTShift = return list.rtShift.mean
/ meanRTRepeat = return list.rtRepeat.mean

/ switchCost = return (expressions.meanRTShift - expressions.meanRTRepeat)
</expressions>

*************************************************
Data Lists: used for descriptive statistics
store correct latencies/accuracy data
fill up during runtime
*************************************************


Note: list stores 1 = correct response; 0 = incorrect response for each relevant trial
any response coded as an error is automatically coded as 0

<list accBlock>
</list>

<list accShape>
</list>

<list accColor>
</list>

<list accShift>
</list>

<list accRepeat>
</list>

Note: list stores the latency of correct responses for each relevant trial
<list rtShape>
</list>

<list rtColor>
</list>

<list rtShift>
</list>

<list rtRepeat>
</list>


*******************************************************************************************************************
*******************************************************************************************************************
	INSTRUCTIONS
*******************************************************************************************************************
*******************************************************************************************************************

*************************
Instruction Stimuli
*************************


*************************
Instruction Trials
*************************

<text instructions>
/ items = instructions
/ select = expressions.selectInstruct
/ fontStyle = ("Arial",3.5%, false, false, false, false, 5, 1)
</text>
<expressions>
/ selectInstruct = return (values.selectInstruct-1); //0-based selection
</expressions>


<text leftResponseText>
/ items = ("<%parameters.responseKeyLeft%>")
/ fontStyle = ("Arial", 2.5%, true, false, false, false, 5, 1)
/ size = (40%, 3%)
/ vJustify = center
/ txColor = gray
/ position = (25%, 90%)
/ vAlign = bottom
</text>

<text leftResponseTextColor>
/ items = ("<%expressions.leftKeyAssignedColor%>")
/ fontStyle = ("Arial", 2%, false, false, false, false, 5, 1)
/ size = (40%, 3%)
/ vJustify = center
/ txColor = gray
/ position = (25%, 90%)
/ vAlign = top
</text>

<text leftResponseTextShape>
/ items = ("<%expressions.leftKeyAssignedShape%>")
/ fontStyle = ("Arial", 2%, false, false, false, false, 5, 1)
/ size = (40%, 3%)
/ vJustify = center
/ txColor = gray
/ hPosition = text.leftResponseTextColor.x
/ vPosition = pct(text.leftResponseTextColor.y + text.leftResponseTextColor.height)
/ vAlign = top
</text>

<text rightResponseText>
/ items = ("<%parameters.responseKeyRight%>")
/ fontStyle = ("Arial", 2.5%, true, false, false, false, 5, 1)
/ size = (40%, 3%)
/ vJustify = center
/ txColor = gray
/ position = (75%, 90%)
/ vAlign = bottom
</text>

<text rightResponseTextColor>
/ items = ("<%expressions.rightKeyAssignedColor%>")
/ fontStyle = ("Arial", 2%, false, false, false, false, 5, 1)
/ size = (40%, 3%)
/ vJustify = center
/ txColor = gray
/ position = (75%, 90%)
/ vAlign = top
</text>

<text rightResponseTextShape>
/ items = ("<%expressions.rightKeyAssignedShape%>")
/ fontStyle = ("Arial", 2%, false, false, false, false, 5, 1)
/ size = (40%, 3%)
/ vJustify = center
/ txColor = gray
/ hPosition = text.rightResponseTextColor.x
/ vPosition = pct(text.rightResponseTextColor.y + text.rightResponseTextColor.height)
/ vAlign = top
</text>


<trial intro1>
/ onTrialBegin = {
	values.selectInstruct = 1;
}
/ stimulusFrames = [1 = instructions, header, continue]
/ validResponse = (" ")
/ branch = {
	return trial.intro2;
}
/ recordData = false
</trial>


<trial intro2>
/ onTrialBegin = {
	values.selectInstruct = 2;
}
/ stimulusFrames = [1 = instructions, header, leftResponseText, leftResponseTextColor, rightResponseText, rightResponseTextColor, 
goBack,continue]
/ validResponse = ("B", " ")
/ branch = {
	if (this.responseText == "B"){
		return trial.intro1;
	} else {
		return trial.intro3;
	}
}
/ recordData = false
</trial>

<trial intro3>
/ onTrialBegin = {
	values.selectInstruct = 3;
}
/ stimulusFrames = [1 = instructions, header, leftResponseText, leftResponseTextShape, rightResponseText, rightResponseTextShape, continue, goBack]
/ validResponse = ("B", " ")
/ branch = {
	if (this.responseText == "B"){
		return trial.intro2;
	} else {
		return trial.intro4;
	}
}
/ recordData = false
</trial>

<trial intro4>
/ onTrialBegin = {
	values.selectInstruct = 4;
}
/ stimulusFrames = [1 = instructions, header, leftResponseText, leftResponseTextColor, leftResponseTextShape, 
rightResponseText, rightResponseTextColor, rightResponseTextShape, continue, goBack]
/ validResponse = ("B", " ")
/ branch = {
	if (this.responseText == "B"){
		return trial.intro3;
	} else {
		return null;
	}
}
/ recordData = false
</trial>

<trial practiceInstruct>
/ validResponse = (" ")
/ recordData = true
</trial>

<trial testInstruct>
/ onTrialBegin = {
	values.selectInstruct = 5;
}
/ stimulusFrames = [1 = instructions, header, leftResponseText, leftResponseTextColor, leftResponseTextShape, 
rightResponseText, rightResponseTextColor, rightResponseTextShape]
/ validResponse = (" ")
/ recordData = false
</trial>


*******************************************************************************************************************
*******************************************************************************************************************
	STIMULI
*******************************************************************************************************************
*******************************************************************************************************************

Notes:
* selects the appropriate stimulus via values.selectstim (set in trials)
<picture stimulus>
/ items = stimuli
/ select = expressions.selectstim
/ position = (50%, 50%)
/ size = (100%, parameters.stimHeight)
</picture>
<expressions>
/ selectstim = return (values.selectstim - 1); //0-based selection
</expressions>


Notes:
* selects the appropriate cue via values.selectcue (set in trials)
<picture cue>
/ items = cues
/ select = expressions.selectCue
/ position = (50%, parameters.cuePosition)
/ height = parameters.cueHeight
</picture>
<expressions>
/ selectCue = return (values.selectCue-1); //0-based selection
</expressions>


*******************************************************************************************************************
*******************************************************************************************************************
	PRACTICE LISTS
*******************************************************************************************************************
*******************************************************************************************************************

Notes:
* randomly samples the first task (Shape (1) vs. Color (2))
<list firstTask>
/ items = (1, 2)
/ replace = true
</list>

Notes:
* randomly selects itemnumber of the bivalent stimuli (without replacement) for practice
* each of the four bivalent stimulus appears equally often
<list practiceStimuli>
/ items = (1, 2, 3, 4)
/ poolSize = parameters.numberPracticeTrials
/ replace = false
/ resetInterval = 1
</list>

Notes:
* randomly selects itemnumber of the bivalent stimuli (without replacement)
* each of the four bivalent stimulus appears equally often
<list stimuli>
/ items = (1, 2, 3, 4)
/ poolSize = parameters.numberOfTestTrials
/ replace = false
/ resetInterval = 1
</list>

*******************************************************************************************************************
*******************************************************************************************************************
	TRIALS
*******************************************************************************************************************
*******************************************************************************************************************

<trial newRound>
/ stimulusFrames = [1 = newRound]
/ validResponse = (" ")
/ recordData = false
/ correctResponse = (" ")
/ errorMessage = false
</trial>



////////////////////////////////////////////////
functions that apply to all trials
////////////////////////////////////////////////

<script>
//trial setUp:
function init(shiftTask, tempThis){
	values.shiftTask = shiftTask;
	values.responseCategory = "";	
	
	//cueSelection:
	if (values.categorizationTask == "Shape") {
		values.selectCue = 2;		
	} else {
		values.selectCue = 1;
	}
	
	//stimSelection:
	if (shiftTask != "firstTrial"){
		if (script.currentBlock == block.practice) {
			values.selectstim = list.practiceStimuli.nextValue;
		} else {
			values.selectstim = list.stimuli.nextValue;
		}	
	} else {
		values.selectstim = replace([1, 2, 3, 4]);
	}

	if (values.selectstim == 1) {
		values.shape = "Circle"; 
		values.color = "Red";
	} else if (values.selectstim == 2) {
		values.shape = "Triangle"; 
		values.color = "Red";
	} else if (values.selectstim == 3) {
		values.shape = "Circle"; 
		values.color = "Green";
	} else if (values.selectstim == 4) {
		values.shape = "Triangle"; 
		values.color = "Green";
	}

	//dynamic stimuli insertion:
	tempThis.insertStimulusTime(picture.stimulus, values.soa);	
}
//accuracy evaluation:
function accEval(tempThis){
	return ((values.categorizationTask == "Shape" && values.selectstim == 1 && tempThis.responseText == values.responseKeyCircle) || 
		(values.categorizationTask == "Color" && values.selectstim == 1 && tempThis.responseText == values.responseKeyRed) || 
		(values.categorizationTask == "Shape" && values.selectstim == 2 && tempThis.responseText == values.responseKeyTriangle) ||
		(values.categorizationTask == "Color" && values.selectstim == 2 && tempThis.responseText == values.responseKeyRed) ||
		(values.categorizationTask == "Shape" && values.selectstim == 3 && tempThis.responseText == values.responseKeyCircle) ||
		(values.categorizationTask == "Color" && values.selectstim == 3 && tempThis.responseText == values.responseKeyGreen) ||
		(values.categorizationTask == "Shape" && values.selectstim == 4 && tempThis.responseText == values.responseKeyTriangle) ||
		(values.categorizationTask == "Color" && values.selectstim == 4 && tempThis.responseText == values.responseKeyGreen));
}
//trial cleanUp:
function onEnd(tempThis){
	tempThis.resetStimulusFrames();
	
	values.stimulus = picture.stimulus.currentItem;	
	
	values.responseKeyMapping = "Inconsistent";	
	if (values.selectstim == 1 && values.responseKeyRed == values.responseKeyCircle) {
		values.responseKeyMapping = "Consistent";
	} else if (values.selectstim == 2 && values.responseKeyRed == values.responseKeyTriangle) {
		values.responseKeyMapping = "Consistent";
	} else if (values.selectstim == 3 && values.responseKeyGreen == values.responseKeyCircle) {
		values.responseKeyMapping = "Consistent";
	} else if (values.selectstim == 4 && values.responseKeyGreen == values.responseKeyTriangle) {
		values.responseKeyMapping = "Consistent";
	}
	
	//convert scancode of response to responseCategory
	if (values.categorizationTask == "Shape"){
		if (tempThis.responseText == values.responseKeyCircle){
			values.responseCategory = "Circle";
		} else if (tempThis.responseText == values.responseKeyTriangle){
			values.responseCategory = "Triangle";
		}
	} else if (values.categorizationTask == "Color"){
		if (tempThis.responseText == values.responseKeyRed){
			values.responseCategory = "Red";
		} else if (tempThis.responseText == values.responseKeyGreen){
			values.responseCategory = "Green";
		}
	} 
	
	//Summary Variables:
	if (values.shiftTask != "firstTrial"){
		list.accBlock.appendItem(tempThis.correct);
		list["acc" + values.shiftTask].appendItem(tempThis.correct);	
		list["acc" + values.categorizationTask].appendItem(tempThis.correct);
			
		if (tempThis.correct) {
			list["rt" + values.shiftTask].appendItem(tempThis.latency);
			list["rt" + values.categorizationTask].appendItem(tempThis.latency);
		}		
	}	
}
</script>


Note: 
* determines the first judgmenttask (Shape vs. Color) (cannot be a "Shift" nor "Repeat" trial)
which is selected at random for each participant (controlled via list.firsttask)
* selects the first stimulus randomly (controlled via list.stimuli)
* calls trial.iti

<trial firstTask>
/ onTrialBegin = {
	values.soa = list.soas.nextValue;
	values.firstTask = list.firstTask.nextValue;
	
	if (values.firstTask == 1) {
		values.categorizationTask = "Shape";	
	} else {
		values.categorizationTask = "Color";
	}
	
	init("firstTrial", this);
}
/ stimulusTimes = [0 = cue, 
leftResponseText, leftResponseTextColor, leftResponseTextShape,
rightResponseText, rightResponseTextColor, rightResponseTextShape,
]
/ beginResponseTime = values.soa
/ responseInterrupt = immediate
/ validResponse = (parameters.responseKeyLeft, parameters.responseKeyRight)
/ isCorrectResponse = {
	return accEval(this);
}
/ onTrialEnd = {
	onEnd(this);
}
/ postTrialPause = parameters.iti
/ branch = {
	return trial.selectTrial;
}
</trial>

Note:
* determines whether a shift (1) or repeat (2) trial should be run next
<trial selectTrial>
/ onTrialBegin = {
	values.soa = list.soas.nextValue;
	values.countTrials++;
	
	if (script.currentBlock == block.practice) {
		values.nextTrial = list.practiceShiftRepeatFrequency.nextValue;
	} else {
		values.nextTrial = list.shiftRepeatFrequency.nextValue;
	}
}
/ validResponse = (parameters.responseKeyLeft, parameters.responseKeyRight)
/ isValidResponse = {
	return false; //necessary to present continuous response buttons for touchscreen devices
}
/ branch = {
	if (values.nextTrial == 1) {
		return trial.shift;
	} else {
		return trial.repeat;
	}
}
/ trialDuration = 0
/ recordData = false
/ errorMessage = false
</trial>

Note:
* switches judgment tasks
* selects next stimuli randomly via list.stimuli
* calls trial.iti

<trial shift>
/ onTrialBegin = {	
	//change categorizationTask:
	if (values.categorizationTask == "Shape") {
		//in case the previous categorization task was 'shape' the current one needs to be 'color'		
		values.categorizationTask = "Color";
	} else {
		//in case the previous categorization task was 'color' the current one needs to be 'shape'	
		values.categorizationTask = "Shape"; 
	}
	
	init("Shift", this);
}
/ stimulusTimes = [0 = cue, 
leftResponseText, leftResponseTextColor, leftResponseTextShape,
rightResponseText, rightResponseTextColor, rightResponseTextShape,
]
/ beginResponseTime = values.soa
/ responseInterrupt = immediate
/ validResponse = (parameters.responseKeyLeft, parameters.responseKeyRight)
/ isCorrectResponse = {
	return accEval(this);
}
/ onTrialEnd = {
	onEnd(this);
}
/ postTrialPause = parameters.iti
/ branch = {
	return trial.selectTrial;
}
</trial>
	
Note:
* repeats judgment task
* calls trial.iti
<trial repeat>
/ onTrialBegin = {
	init("Repeat", this);
}
/ stimulusTimes = [0 = cue, 
leftResponseText, leftResponseTextColor, leftResponseTextShape,
rightResponseText, rightResponseTextColor, rightResponseTextShape,
]
/ beginResponseTime = values.soa
/ responseInterrupt = immediate
/ validResponse = (parameters.responseKeyLeft, parameters.responseKeyRight)
/ isCorrectResponse = {
	return accEval(this);
}
/ onTrialEnd = {
	onEnd(this);
}
/ postTrialPause = parameters.iti
/ branch = {
	return trial.selectTrial;
}
</trial>

*******************************************************************************************************************
*******************************************************************************************************************
	BLOCKS
*******************************************************************************************************************
*******************************************************************************************************************

<block intro>
/ trials = [1 = intro1]
</block>

<block practice>
/ stop = {return (values.countTrials == parameters.numberPracticeTrials + 1);}
/ onBlockBegin = {
	values.practice = 1;
	values.countPracticeBlocks++;
	values.countTrials = 0;
	list.accShape.reset();
	list.rtShape.reset();
	list.accColor.reset();
	list.rtColor.reset();
	list.accShift.reset();
	list.rtShift.reset();
	list.accRepeat.reset();
	list.rtRepeat.reset();	
	list.accBlock.reset();
}
/ trials = [
	1 = newRound;
	2 = getReady; 
	3 = firstTask;
]
/ onBlockEnd = {
	values.practiceAcc = list.accBlock.mean;
}
/ errorMessage = true(errorFeedback, 1000)
/ onBlockEnd = {
	if (list.accBlock.mean >= parameters.minPracticeAcc){
		values.practicePass = 1;
	} else {
		values.practicePass = 0;
	}
}
/ branch = {
if (!monkey.monkeyMode){
	if (values.practicePass == 0){
		if (values.countPracticeBlocks < parameters.maxNumberPracticeBlocks){
			return this;
		} else {
			if (parameters.abortPractice == true){
				return block.prematureEnd;
			} else {
				return null;
			}
		}
	} else {
		return null;
	}
} else {
	return null;
}
}
</block>

<block testintro>
/ trials = [1 = testInstruct]
/ onBlockBegin = { 
	list.accShape.reset();
	list.rtShape.reset();
	list.accColor.reset();
	list.rtColor.reset();
	list.accShift.reset();
	list.rtShift.reset();
	list.accRepeat.reset();
	list.rtRepeat.reset();	
	values.practice = 2;
}
</block>

<block test>
/ stop = {return (values.countTrials == parameters.numberOfTestTrials + 1);}
/ onBlockBegin = {
	values.countTestBlocks++;
	values.countTrials = 0;
	list.accBlock.reset();

}
/ trials = [
	1 = newRound;
	2 = getReady; 
	3 = firstTask;
]
/ postInstructions = (blockFeedback)
/ branch = {
	if (values.countTestBlocks < parameters.numberOfTestBlocks){
		return this;
	} else {
		return null;
	}
}
</block>

<block prematureEnd>
/ onBlockEnd = {
	script.abort();
}
</block>

*******************************************************************************************************************
*******************************************************************************************************************
	EXPERIMENT: controls the flow of the experiment (customize)
*******************************************************************************************************************
*******************************************************************************************************************
Notes: 
- response key mappings are counterbalanced by groupnumber (1-4) -> 4 expt elements
		1 = red and circle on one response key (default: A)
		2 = red and triangle on one response key (default: L)
		3 = red and triangle on one response key (default: A)
		4 = red and circle on one response key (default: L)


<expt a>
/ groups = (1 of 4)
/ onExptBegin = {
	values.group = 1;
	values.responseKeyCircle = parameters.responseKeyLeft; 
	values.responseKeyTriangle = parameters.responseKeyRight; 
	values.responseKeyRed = parameters.responseKeyLeft; 
	values.responseKeyGreen = parameters.responseKeyRight; 
	
	if (!computer.hasKeyboard && computer.touch){
		text.continue.skip = true;
		text.goBack.skip = true;
	}	
}
/ blocks = [
	1 = intro;
	2 = practice; 
	3 = testintro;
	4 = test;
]
</expt>

<expt b>
/ groups = (2 of 4)
/ onExptBegin = {
	values.group = 2;
	values.responseKeyCircle = parameters.responseKeyLeft; 
	values.responseKeyTriangle = parameters.responseKeyRight; 
	values.responseKeyRed = parameters.responseKeyRight; 
	values.responseKeyGreen = parameters.responseKeyLeft; 
	
	if (!computer.hasKeyboard && computer.touch){
		text.continue.skip = true;
		text.goBack.skip = true;
	}		
}
/ blocks = [
	1 = intro;
	2 = practice; 
	3 = testintro;
	4 = test;
]
</expt>

<expt c>
/ groups = (3 of 4)
/ onExptBegin = {
	values.group = 3;
	values.responseKeyCircle = parameters.responseKeyRight; 
	values.responseKeyTriangle = parameters.responseKeyLeft; 
	values.responseKeyRed = parameters.responseKeyLeft; 
	values.responseKeyGreen = parameters.responseKeyRight; 
	
	if (!computer.hasKeyboard && computer.touch){
		text.continue.skip = true;
		text.goBack.skip = true;
	}		
}
/ blocks = [
	1 = intro;
	2 = practice; 
	3 = testintro;
	4 = test;
]
</expt>

<expt d>
/ groups = (4 of 4)
/ onExptBegin = {
	values.group = 4;
	values.responseKeyCircle = parameters.responseKeyRight; 
	values.responseKeyTriangle = parameters.responseKeyLeft; 
	values.responseKeyRed = parameters.responseKeyRight; 
	values.responseKeyGreen = parameters.responseKeyLeft; 
	
	if (!computer.hasKeyboard && computer.touch){
		text.continue.skip = true;
		text.goBack.skip = true;
	}		
}
/ blocks = [
	1 = intro;
	2 = practice; 
	3 = testintro;
	4 = test;
]
</expt>

