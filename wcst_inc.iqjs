	} else if (values.card == 18) {
		values.cardCode = "redStar2";
	} else if (values.card == 19) {
		values.cardCode = "redStar3";
	} else if (values.card == 20) {
		values.cardCode = "redStar4";
	} else if (values.card == 21) {
		values.cardCode = "greenStar1";
	} else if (values.card == 22) {
