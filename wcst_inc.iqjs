	EXPRESSIONS
**************************************************************************************************************
*************************************************************************************************************

<expressions>
/ trialCount = return (values.colorTrialCount + values.formTrialCount + values.numberTrialCount)
/ tooManyTrials = return (values.colorTrialCount + values.formTrialCount + values.numberTrialCount == parameters.csTotalTrials)
/ tooManyBlocks = return ((block.color.count == parameters.csTotalBlocks) && (block.form.count == parameters.csTotalBlocks) && (block.number.count == parameters.csTotalBlocks))
</expressions>

**************************************************************************************************************
**************************************************************************************************************
	SCORING
**************************************************************************************************************
**************************************************************************************************************
\
<script>
function determineConsecutiveCorrectResponses() {

	var category = "";
	var prevCategory = "";
	var acc = "";
	var conACC = 0;
	var blockCounts = 0;
	var trialCountPerCategory = 0;
	
	for (var i=0; i<trialData.length;i++){
		prevCategory = category;
		category = trialData[i].category;
		if (prevCategory != category){//for category changes, reset cumACC
			conACC = 0;
			blockCounts++;//a new block is started
			trialCountPerCategory = 0; //this is the first trial in a new block;
		}
		trialCountPerCategory++;
		
		acc = trialData[i].acc;
		if (acc){
			conACC++;
		} else {
			conACC = 0;
		}
		
		trialData[i].consecutiveAcc = conACC;
		trialData[i].blockCount = blockCounts;
		trialData[i].trialCountPerCategory = trialCountPerCategory;		
	}//end of for loop
	
}//end of expression

function determineAmbiguousResponses() {

	var responseCategory = "";
	var ambiguous = 0;
	
	for (var i=0; i<trialData.length;i++){
		ambiguous = 0;
		
		responseCategory = trialData[i].respCategory;
		if (responseCategory == "O"){
			ambiguous = 1;
		} else if (length(responseCategory) > 1){
			ambiguous = 1;
		}
		trialData[i].ambiguousResponse = ambiguous;
	}
}

function countOtherErrors(){
	var resp = "";
	var countO = 0;
	
	for(var i=0; i<trialData.length;i++){
		if (trialData[i].respCategory == "O"){
			countO++;
		}
	}
	return (countO);
}
//////////////////////////////////////////////////////
//PerserverativeResponses Re-scoring
//////////////////////////////////////////////////////

//the following helper array stores the counts for consecutive C,F,N errors during scoring of PerserverativeResponses
var helperErrorCountsArray = [
	{
		category:"C",
		counts:0
	},
	{
		category:"F",
		counts:0
	},
	{
		category:"N",
		counts:0
	}
]

function determinePerserverativeResponses() {

	var ambiguous = "";
	var acc = "";
	var responseCategory = "";
	var category = "";
	var previousCategory = "";
	var pResponsePrinciple = "";
	var pResponse = "";
	var lastpResponseIndex = "";
	var j = "";
	
	//reset counts for consecutive C,F,N errors
	for (var m=0; m<3;m++){
		helperErrorCountsArray[m].counts = 0;
	}
	
	var ua_error_index1 = 0; //stores the index of the first unambiguous error
	var ua_error_index2 = 0; //stores the index of the second unambiguous error
	
	for(var i=0; i<trialData.length;i++){
		pResponse = 0;//default value of the pResponse (0 = no pResponse)
		
		//check if status of 'pResponse' needs to be changed:
		//retrieve necessary data from the rawData lists:
		acc = trialData[i].acc;
		previousCategory = category;		
		category = trialData[i].category;
		ambiguous = trialData[i].ambiguousResponse;
			
		//check if this is the start of a new block:
		if (trialData[i].trialCountPerCategory == 1){		

			//reset counts for consecutive C,F,N errors
			for (var m=0; m<3;m++){
				helperErrorCountsArray[m].counts = 0;
			}
				
			//reset indices that track unambiguous errors of the non-p error category
			ua_error_index1 = -1;
			ua_error_index2 = -1;
			
			//reset/determine pResponse for the new block
			pResponsePrinciple = "";	
			if (previousCategory == 1){
				pResponsePrinciple = "C";
			} else if (previousCategory == 2){
				pResponsePrinciple = "F";
			} else if (previousCategory == 3){
				pResponsePrinciple = "N";
			}
			lastpResponseIndex = "";
		}	
		
		if (!acc && trialData[i].respCategory != "O"){//ONLY for ERROR responses of C,F,N category (other errors and correct responses are not checked for pResponse status at this point - although they may be retroactively scored as a p-value later)
			if (!ambiguous){//only for unambiguous error responses (ambiguous errors are not further checked for for pResponse status at this point - although they may be retroactively scored as a p-value later))
				if (pResponsePrinciple == ""){//the pResponse-principle has not been set yet (should only be the case for first block)
					pResponsePrinciple = trialData[i].respCategory;//set the pResponsePrinciple
				
					//update consecutive unambiguous pResponse categories in the helperErrorCountsArray
					for (m = 0; m<3; m++){
						if (pResponsePrinciple == helperErrorCountsArray[m].category){
							helperErrorCountsArray[m].counts++;
							ua_error_index1 = i;
						} else {
							helperErrorCountsArray[m].counts = 0;
						}
					}		
				} else {//pResponse-principle has been previously set
				
					for (m = 0; m<3; m++){
						if (trialData[i].respCategory == helperErrorCountsArray[m].category){//update unambiguous consecutive counts for the current error category
							helperErrorCountsArray[m].counts++;
							if (helperErrorCountsArray[m].counts == 1){
								ua_error_index1 = i;
							} else if (helperErrorCountsArray[m].counts == 2){
								ua_error_index2 = i;
							}
						} else {
							helperErrorCountsArray[m].counts=0;//reset unambiguous consecutive counts for the other two categories
						}
					}
	

					//check if pResponse-principle may need to change:
					if (trialData[i].respCategory != pResponsePrinciple){//for all unambiguous errors that are NOT of the pResponse-principle
						for (m = 0; m<3; m++){//check which helperErrorCountsArray category corresponds to the current error
							if (trialData[i].respCategory == helperErrorCountsArray[m].category){
								if (helperErrorCountsArray[m].counts == 3){//the last three consecutive unambiguous errors were error of the current responseCategory
								//need to check the intermediate responses (between the first and third consecutive unambiguous error)
									j = i - 1;
									pResponse = 1;
									while (j > ua_error_index1 && pResponse == 1){
										pResponse = trialData[j].respCategory;
										if (contains(pResponse,helperErrorCountsArray[m].category) || pResponse == "O" || trialData[j].acc){//'Other' errors and correct responses get ignored in checking previous errors
											pResponse = 1;//'other' error/correct responses responses get temporarily classified as a p-response
											j--;
										} else {	
											pResponse = 0;
										}
									}
								
									if (j == ua_error_index1){//responses btw. the third and the first pResponse all contain current responseCategory as a response
										pResponsePrinciple = helperErrorCountsArray[m].category; //pResponse-principle changes!
										helperErrorCountsArray[m].counts = 0;//reset the counts	
										j = i-1;
										while (j >= ua_error_index2){////retrospectively change the status of the previously errors to pResponses
											if (contains(pResponse,pResponsePrinciple)){
												trialData[j].pResponse = 1;
											}
											trialData[j].pResponsePrinciple = helperErrorCountsArray[m].category;											
											j--;
										}
																														
										pResponse = 1;//the item at index i is a pResponse
										lastpResponseIndex = i;
										
										ua_error_index1 = -1;
										ua_error_index2 = -1;																				
									} else {
										helperErrorCountsArray[m].counts--;//there was at least one case that did not conform to the possible 'new' pResponse
										ua_error_index1 = ua_error_index2;
										ua_error_index2 = i;
									}
								}
							}												
						}	
					} else if (trialData[i].respCategory == pResponsePrinciple){	
						if (lastpResponseIndex != ""){//check if a pResponse has already been found in this block
							//now we need to check for sandwich pResponses:
							j = i-1;
							pResponse = 1;//yes,the current response is a pResponse
						
							while (j > lastpResponseIndex && pResponse==1){//same block, consecutive pResponse, index still larger lastpResponseIndex
								pResponse = trialData[j].respCategory; 
								if (contains(pResponse,pResponsePrinciple) || pResponse == "O" || trialData[j].acc){//other errors/correct responses get ignored
									j--;
									pResponse = 1;
								} else {
									pResponse = 0;
								}		

							}//once the while loop ends, compare index j to lastpResponseIndex
							
							if (j == lastpResponseIndex){//potential sandwich pResponses found!
								j = i-1;
								while (j > lastpResponseIndex){
									if (contains(pResponse,pResponsePrinciple)){
										trialData[j].pResponse = 1;//retrospectively change the status of the previously recorded pResponses
									}									
									j--;
								}	
							}
						}												
						pResponse = 1;//the item at index i is a pResponse
						lastpResponseIndex = i;								
					}
				}
			}
		}		
		trialData[i].pResponse = pResponse;
		trialData[i].pResponsePrinciple = pResponsePrinciple;	
		trialData[i].lastpResponseIndex = lastpResponseIndex;
		trialData[i].conErrorCounts[0] = helperErrorCountsArray[0].counts;
		trialData[i].conErrorCounts[1] = helperErrorCountsArray[1].counts;
		trialData[i].conErrorCounts[2] = helperErrorCountsArray[2].counts;		
		
	}//end big for loop
	
}
</script>

<expressions>
/ numberpResponses = {
	if (trialData[0].pResponse == null){
		return ("not analyzed yet")
	} 
	
	var countpResponses = 0;
	for (var i=0; i<trialData.length; i++){
		countpResponses += trialData[i].pResponse;
	}
	return (countpResponses);
}

/ percentpResponses = {
	if (trialData[0].pResponse == null){
		return ("not analyzed yet")
	}
	return (expressions.numberpResponses/trialData.length)*100;	
}

/ numberPErrors = {
	if (trialData.length == 0){
		return ("not analyzed yet")
	}
	
	var countErrors = 0;
	for (var i=0; i<trialData.length; i++){
		if (trialData[i].pError == 1){
			countErrors += 1;			
		}		
	}
	return (countErrors);			
	
}	

/ percentPErrors = {
	if (trialData.length == 0){
		return ("not analyzed yet")
	}
	return (expressions.numberPErrors/trialData.length)*100;		
	
}
/ numberErrors = {
	if (trialData.length == 0){
		return ("not analyzed yet")
	}
	
	var countErrors = 0;
	for (var i=0; i<trialData.length; i++){
		if (trialData[i].acc == 0){
			countErrors += 1;			
		}		
	}
	return (countErrors);	
}	

/ percentErrors = {
	if (trialData.length == 0){
		return ("not analyzed yet")
	}
	return (expressions.numberErrors/trialData.length)*100;		
}

/ percentOtherErrors = if (values.numberOtherErrors != "not analyzed yet") {
	return (values.numberOtherErrors/trialData.length);
} else return "not analyzed yet";

/ diffC1F1 = if (values.percentErrorF1 != ""){
	return (values.percentErrorC1 - values.percentErrorF1);	
} else {
	return "NA";
}

/ diffF1N1 = if (values.percentErrorF1 != "" && values.percentErrorN1 != ""){
		return (values.percentErrorF1 - values.percentErrorN1);	
} else {
	return "NA";
}

/ diffN1C2 = if (values.percentErrorN1 != "" && values.percentErrorC2 != ""){
	return (values.percentErrorN1 - values.percentErrorC2);
} else {
	return "NA";
}

/ diffC2F2 = if (values.percentErrorC2 != "" && values.percentErrorF2 != ""){
	return (values.percentErrorC2 - values.percentErrorF2);
} else {
	return "NA";
}

/ diffF2N2 = if (values.percentErrorF2 != "" && values.percentErrorN2 != ""){
	return (values.percentErrorF2 - values.percentErrorN2);
} else {
	return "NA";
}
/ calculateLearningToLearn = {
	if (expressions.diffF1N1 != "NA"){
		values.sumDiffScores += expressions.diffF1N1;
		values.countDiffScores++;
	}	
	if (expressions.diffN1C2 != "NA"){
		values.sumDiffScores += expressions.diffN1C2;
		values.countDiffScores++;
	}	
	if (expressions.diffC2F2 != "NA"){
		values.sumDiffScores += expressions.diffC2F2;
		values.countDiffScores++;
	}
	if (expressions.diffF2N2 != "NA"){
		values.sumDiffScores += expressions.diffF2N2;
		values.countDiffScores++;
	}	
	
	if (values.countDiffScores > 0){
		values.learningToLearn = values.sumDiffScores/values.countDiffScores;				
	} else {
		values.learningToLearn = "NA";
	}
}
</expressions>

<trial scoring>
/ onTrialBegin = {
	values.index++;
		
	values.scoringDeckCount = trialData[values.index].deckCount;
	values.scoringTrialCount = trialData[values.index].trialCount;
	values.scoringtrialCountPerCategory = trialData[values.index].trialCountPerCategory;
	values.scoringCategoryCount = trialData[values.index].blockCount;
	values.scoringCategory = trialData[values.index].category;
	values.scoringCard = trialData[values.index].card;
	values.scoringResponse = trialData[values.index].resp;
	values.scoringRespCategories = trialData[values.index].respCategory;
	values.scoringAcc = trialData[values.index].acc;
	values.scoringCorrectStreak = trialData[values.index].consecutiveAcc;
	values.scoringAmbiguousResponse = trialData[values.index].ambiguousResponse;
	values.scoringPerseverativeResponse = trialData[values.index].pResponse;
	values.scoringpResponsePrinciple = trialData[values.index].pResponsePrinciple;
	values.scoringPerseverativeError = 0;
	if (values.scoringAcc == 0 && values.scoringPerseverativeResponse == 1) {
		values.scoringPerseverativeError = 1;
	}
	trialData[values.index].pError = values.scoringPerseverativeError;
}
/ trialDuration = 0
/ recordData = true
/ branch = {
	if (values.index < trialData.length-1) {
		return this;
	} else {
		return null;
	}
}
</trial>

