<trial card>
/ inputDevice = mouse
/ beginResponseTime = 200
/ correctMessage = true(correctFeedback, 400)
/ errorMessage = true(wrong,400)
/ onTrialBegin = {
	values.pResponse = 0;
	values.ambiguous = 1;//by default, a response is ambiguous until proven otherwise
	values.cardsFromADeck++;

	//check if list.selectCard has to be resetted to mimic deck#2
	if ((values.colorTrialCount + values.formTrialCount + values.numberTrialCount) == 64) {
		list.selectCard.reset();
		values.numberOfDecks++;
		values.cardsFromADeck = 1;
	}
	
	//select next card:
	values.card = list.selectCard.nextValue;
	if (values.card == 1) {
		values.cardCode = "redTriangle1";
	} else if (values.card == 2) {
