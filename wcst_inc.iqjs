		values.cardCode = "blueCircle4";
	}
	
	//update trialCounts based on current category
	if (values.category == 1) {
		values.colorTrialCount++;
	} else if (values.category == 2) {
		values.formTrialCount++;
	} else if (values.category == 3) {
		values.numberTrialCount++;
	}
}
/ stimulusFrames = [1=playCard, redTriangle1, greenStar2, yellowCross3, blueCircle4, deck]
/ validResponse = (redTriangle1, greenStar2, yellowCross3, blueCircle4)
/ isCorrectResponse = {
	//determine the category letter of correct category:
	var correctCat = ""
	if (values.category == 1){
		correctCat = "C";
	} else if (values.category == 2){
		correctCat = "F";
	} else if (values.category == 3){
		correctCat = "N";
	}

	//determine played card's color, form and number based on values.cardCode
	var cardNumber = subString(values.cardCode, length(values.cardCode)-1,1);
	var cardForm = "Cross";
	if (contains(values.cardCode,"Circle")){
		cardForm = "Circle";
	} else if (contains(values.cardCode,"Triangle")){
		cardForm = "Triangle";
	} else if (contains(values.cardCode,"Star")){
		cardForm = "Star";
	}
	var cardColor = "red";
	if (contains(values.cardCode,"green")){
		cardColor = "green";
	} else if (contains(values.cardCode,"blue")){
		cardColor = "blue";
	} else if (contains(values.cardCode,"yellow")){
		cardColor = "yellow";
	}

	//determine the response card's color, form and number based on the trialcode	
	var respNumber = subString(this.response, length(this.response)-1,1);
	var respForm = "Cross";
	if (contains(this.response,"Circle")){
		respForm = "Circle";
	} else if (contains(this.response,"Triangle")){
		respForm = "Triangle";
	} else if (contains(this.response,"Star")){
		respForm = "Star";
	}
	var respColor = "red";
	if (contains(this.response,"green")){
		respColor = "green";
	} else if (contains(this.response,"blue")){
		respColor = "blue";
	} else if (contains(this.response,"yellow")){
		respColor = "yellow";
	}
	
	//determine the responseCategory:
	values.responseCategory = "";
	if (respColor == cardColor) {
		values.responseCategory += "C";
	}
	if (respForm == cardForm) {
		values.responseCategory += "F";
	}
	if (respNumber == cardNumber) {
		values.responseCategory += "N";
	}
	
	//if responseCategory is still empty at this point, the category is "O(ther)"
	if (values.responseCategory == ""){
		values.responseCategory = "O";
	}
	
	//if the responseCategory contains the correct category, then it's a correct selection
	if (contains(values.responseCategory,correctCat)){
		return true;
	} else {
		return false;
	}	
}
/ onTrialEnd = {	
	//determine if response choice was unambiguous
	if (length(values.responseCategory)==1){
		values.ambiguous = 0;
	}

	//check for set maintaining error:
	if (values.correctStreak >= parameters.setmaintainThreshold  && this.error) {
		values.sumFailureMaintainSet++;
	}
	
	//trial accuracy assessment
	if (this.correct) {
		values.correctStreak++;
		values.totalCorrect++;
	} else {
		values.correctStreak = 0;
		values.errorSumBlock++;
		values.totalError++ ;
	}

	//store all data of the current trial in the raw data array:	
	trialData.push({
		deckCount: values.numberOfDecks,
		trialCount: expressions.trialCount,
		category: values.category,
		card: values.cardCode,
		respCategory: values.responseCategory,
		acc: this.correct,
		rt: this.latency,
		resp: this.response,
		//updated later:
		ambiguousResponse: values.ambiguous,
		consecutiveAcc: null,
		blockCount: null,
		trialCountPerCategory: null,
		pResponse: null,
		pResponsePrinciple: null,
		pError: null,
		lastpResponseIndex: null,
		conErrorCounts:[0,0,0]
	});
	values.trialData = JSON.stringify(trialData);	
}
/ branch = {
	return this;
}
</trial>

**************************************************************************************************************
**************************************************************************************************************
	BLOCKS
**************************************************************************************************************
**************************************************************************************************************

<script>
function blockInit(categoryNumber, categoryLabel){//categoryLabel with capital letter (Example: Color)
	values.correctStreak = 0;
	values.errorSumBlock = 0;
	values["count" + categoryLabel + "Blocks"]++;
	var helperCategoryLabel = toLower(categoryLabel);
	values[helperCategoryLabel + "BlockCount"]++
	values.category = categoryNumber;	
}

function onBlockEnd(categoryLabel){//categoryLabel with capital letter (Example: Color)
	if (categoryLabel == "Color"){
		if (values.colorBlockCount == 1) {
			values.trialsCompleteFirstCategory = values.colorTrialCount;
		}		
	}
	
	if (values.correctStreak == parameters.correctStreakThreshold) {
		values.completedCategories++;
	}

	var categoryChar = subString(categoryLabel,0,1);	//Example: turns 'Color' into 'C'
	var helperCategoryLabel = toLower(categoryLabel);
	if (values[helperCategoryLabel + "BlockCount"] == 1) {
		values["percentError" + categoryChar + "1"] = 100 * (values.errorSumBlock/trial.card.count);
	} else {
		values["percentError" + categoryChar + "2"] = 100*(values.errorSumBlock/trial.card.count);
	}
}
</script>

<block instructions>
/ onBlockBegin = {
	values.phase = "testing";
}

/ trials = [1 = intro]
</block>

<block color>
/ skip = {
	return (values.colorBlockCount >= parameters.csTotalBlocks)
}
/ stop = {
	return (expressions.tooManyTrials || (values.correctStreak > 0 && mod(values.correctStreak, parameters.correctStreakThreshold)==0))
}
/ onBlockBegin = {
	blockInit(1, "Color");
}
/ trials = [1 = card]
/ onBlockEnd = {
	onBlockEnd("Color");
}
/ branch = {
	if (!expressions.tooManyTrials) return block.form; else return null;
}
</block>

<block form>
/ skip = {
	return (values.formBlockCount >= parameters.csTotalBlocks)
}
/ stop = {
	return (expressions.tooManyTrials || (values.correctStreak > 0 && mod(values.correctStreak, parameters.correctStreakThreshold)==0))
}
/ onBlockBegin = {
	blockInit(2, "Form");
}
/ trials = [1 = card]
/ onBlockEnd = {
	onBlockEnd("Form");
}
/ branch = {
	if (!expressions.tooManyTrials) return block.number; else return null;
}
</block>

<block number>
/ skip = {
	return (values.numberBlockCount >= parameters.csTotalBlocks)
}
/ stop = {
	return (expressions.tooManyTrials || (values.correctStreak > 0 && mod(values.correctStreak, parameters.correctStreakThreshold)==0))
}
/ onBlockBegin = {
	blockInit(3, "Number");
}
/ trials = [1 = card]
/ onBlockEnd = {
	onBlockEnd("Number");
}
/ branch = {
	if (!expressions.tooManyTrials && !expressions.tooManyBlocks) return block.color; else return null;
}
</block>

<block rawDataScoring>
/ onBlockBegin = {
	values.category="";
	values.responseCategory = "";
	values.ambiguous = "";
	values.correctStreak = "";
	values.pResponse = "";
	values.index = -1; //0-based indices; first values.index needs to be 0

	determineConsecutiveCorrectResponses();
	determineAmbiguousResponses();
	determinePerserverativeResponses();
	values.numberOtherErrors = countOtherErrors();
}
/ trials = [1 = scoring]
/ onBlockEnd = {
	values.trialData = JSON.stringify(trialData);
}
</block>

**************************************************************************************************************
**************************************************************************************************************
	EXPERIMENT 
**************************************************************************************************************
**************************************************************************************************************

<expt a>
/ onExptBegin = {
	if (!parameters.showDeckInfo) {
		text.deck.skip = true;
	}
}
/ blocks = [
	1 = instructions;
	2 = color; 
	3 = rawDataScoring;	
]
</expt>

****************************************************End of Script************************************************************
